{
  "name": "infinito-joyas-backend",
  "version": "1.0.0",
  "description": "Backend de Infinito Joyas (Express + Prisma + Mercado Pago)",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "build": "prisma generate && prisma migrate deploy",
    "seed": "node src/seed.js",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "mercadopago": "^2.0.0",
    "prisma": "^5.20.0"
  },
  "engines": {
    "node": ">=18"
  }
}
