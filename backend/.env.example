# Copia este archivo como ".env" en la misma carpeta y completa los valores.
# NUNCA subas el archivo ".env" real a git (ya está en .gitignore).

# Clave secreta de Django. Genera una propia con:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=cambia-esto-por-una-clave-generada-aleatoriamente

# En producción SIEMPRE debe ser False.
DEBUG=True

# Dominios/IPs desde los que se puede servir el backend, separados por coma.
# En producción agrega el dominio del backend, ej:
#   ALLOWED_HOSTS=mi-backend.up.railway.app
ALLOWED_HOSTS=localhost,127.0.0.1

# Orígenes del frontend autorizados a llamar a la API (separados por coma).
# En producción debe ser la URL real del frontend en Vercel, ej:
#   CORS_ALLOWED_ORIGINS=https://infinito-joyas.vercel.app
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Dominios de confianza para CSRF (obligatorio en producción con HTTPS),
# ej: https://infinito-joyas.vercel.app,https://mi-backend.up.railway.app
CSRF_TRUSTED_ORIGINS=

# URLs públicas del frontend y backend (usadas para armar los links de
# Mercado Pago). En producción deben ser las URLs reales con https.
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# Base de datos. En producción usa PostgreSQL (Railway/Render la entregan):
#   DATABASE_URL=postgres://usuario:password@host:5432/nombre_bd
# Si lo dejas sin definir, se usa sqlite local automáticamente.
# DATABASE_URL=postgres://usuario:password@host:5432/nombre_bd

# Credenciales de Mercado Pago (modo prueba o producción).
# Si las dejas vacías, el checkout simplemente no genera link de pago
# (útil para probar el sitio sin cuenta de Mercado Pago).
MERCADO_PAGO_ACCESS_TOKEN=
# OBLIGATORIO en producción: sin este secreto, el webhook rechaza las
# peticiones por seguridad (ver views.py).
MERCADO_PAGO_WEBHOOK_SECRET=
