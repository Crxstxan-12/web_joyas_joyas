# Copia este archivo como ".env" y completa los valores.
# NUNCA subas el ".env" real a git (ya está en .gitignore).

# Puerto del servidor (Railway/Render lo inyecta automáticamente).
PORT=8000

# Clave de la app. En producción es OBLIGATORIA. Genera una con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Si no está definida, el servidor no arranca en producción (NODE_ENV=production).
SECRET_KEY=

# Entorno: "development" o "production".
NODE_ENV=development

# Base de datos (PostgreSQL, tanto en local como en producción).
# En local: instala PostgreSQL o usa Docker, y crea una base "infinito_joyas".
# En producción (Railway/Render): pega la URL que te entrega la plataforma.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/infinito_joyas

# Orígenes del frontend autorizados a llamar a la API (separados por coma).
# En producción: https://infinito-joyas.vercel.app
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# URLs públicas (armarán los links de Mercado Pago y las imágenes).
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# Credenciales de Mercado Pago. Si están vacías, el checkout no genera
# link de pago y el frontend usa el fallback de WhatsApp.
MERCADO_PAGO_ACCESS_TOKEN=
# OBLIGATORIO en producción: valida la firma del webhook.
MERCADO_PAGO_WEBHOOK_SECRET=

# API key para operaciones de administración (crear/editar/borrar productos).
# Si no está definida, las operaciones de escritura quedan deshabilitadas.
ADMIN_API_KEY=
